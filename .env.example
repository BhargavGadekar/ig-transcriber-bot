# ---------------------------------------------------------------------------
# Telegram (required)
# Get api_id/api_hash at https://my.telegram.org (API development tools),
# and the bot token from @BotFather.
# ---------------------------------------------------------------------------
TG_API_ID=123456
TG_API_HASH=your_api_hash_here
TG_BOT_TOKEN=123456:ABC-your-bot-token

# Comma-separated whitelist of Telegram user IDs allowed to use the bot.
# Empty = open to everyone who can message the bot.
ALLOWED_USER_IDS=

# Session name (the .session file lives under DATA_DIR).
SESSION_NAME=igtranscriber

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# Working data dir: SQLite DB, temp files, logs, session file.
DATA_DIR=data

# Netscape-format cookies.txt exported for instagram.com (see README → Cookies).
# Strongly recommended: many reels fail without login cookies.
COOKIES_FILE=data/cookies.txt

# Optional: also save every generated .md here (e.g. your Obsidian vault).
# Empty = only send via Telegram.
MD_OUTPUT_DIR=

# ---------------------------------------------------------------------------
# whisper.cpp
# ---------------------------------------------------------------------------
# Path to the whisper-cli binary (built by scripts/install_whisper_cpp.sh).
# The default assumes you installed it somewhere on PATH; a typical value is
# third_party/whisper.cpp/build/bin/whisper-cli
WHISPER_BIN=whisper-cli

WHISPER_MODEL_PATH=models/ggml-large-v3-turbo-q5_0.bin
WHISPER_MODEL_NAME=large-v3-turbo-q5_0
WHISPER_VAD_MODEL=models/ggml-silero-v6.2.0.bin

# Silero VAD: cuts silence and reduces hallucinated text on music/pauses.
WHISPER_VAD=true

# 0 = auto (all CPU threads minus one).
WHISPER_THREADS=0

# Context carry-over between 30s windows: 0 disables it (recommended — reduces
# repetition loops); -1 restores whisper.cpp's default (unlimited).
WHISPER_MAX_CONTEXT=0

# Extra raw args appended to the whisper-cli invocation (shlex-split), e.g.
# "--beam-size 4". Empty by default.
WHISPER_EXTRA_ARGS=

# Safety timeout: base seconds plus per-audio-second allowance.
WHISPER_TIMEOUT_BASE=600
WHISPER_TIMEOUT_PER_SECOND=15.0

# ---------------------------------------------------------------------------
# Transcript rendering
# ---------------------------------------------------------------------------
# roman  = bias mixed Hindi-English speech toward Roman script via an initial
#          prompt (best effort — see README → Hinglish limits)
# native = let Whisper choose the script (Hindi → Devanagari)
SCRIPT_MODE=roman

ROMAN_PROMPT=Yeh ek Hinglish video hai. Hindi and English mixed, written in Roman script.

# Insert [mm:ss] markers into transcripts roughly every N seconds.
TIMESTAMPS=true
TIMESTAMP_INTERVAL_SECONDS=45

# Keep [MUSIC]-style tags instead of stripping them.
TRANSCRIPT_KEEP_TAGS=false

# Send an inline preview when the transcript is shorter than this many chars.
PREVIEW_MAX_CHARS=3500

# ---------------------------------------------------------------------------
# Limits & concurrency
# ---------------------------------------------------------------------------
MAX_DURATION_SECONDS=1200     # 20 minutes
MAX_FILESIZE_MB=500
RATE_LIMIT_PER_HOUR=0  # 0 = unlimited / disabled
WORKER_CONCURRENCY=1          # transcription workers (CPU-bound; keep 1 on small boxes)
DOWNLOAD_CONCURRENCY=2        # parallel downloads
MAX_LINKS_PER_MESSAGE=25

# ---------------------------------------------------------------------------
# Tooling / ops
# ---------------------------------------------------------------------------
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
HEALTH_CHECK_PORT=8080        # 0 disables; GET /health returns JSON stats
LOG_LEVEL=INFO

# --- AI Summarization (Optional) --------------------------------------------
# Google Gemini API key (AIzaSy...) or any OpenAI-compatible API key (OpenAI, Groq, OpenRouter, DeepSeek, Ollama)
LLM_API_KEY=
# Optional custom endpoint (e.g. https://generativelanguage.googleapis.com/v1beta/openai or https://api.openai.com/v1)
LLM_BASE_URL=
# Optional model name (e.g. gemini-2.5-flash, gemini-1.5-flash, gpt-4o-mini)
LLM_MODEL=

# --- Queue & VPS Optimization -----------------------------------------------
QUEUE_MAX_SIZE=500
WHISPER_NO_MMAP=false
