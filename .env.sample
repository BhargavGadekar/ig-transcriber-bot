# ---------------------------------------------------------------------------
# Telegram (required)
# Get api_id/api_hash at https://my.telegram.org (API development tools),
# and the bot token from @BotFather.
# ---------------------------------------------------------------------------
TG_API_ID=123456
TG_API_HASH=your_api_hash_here
TG_BOT_TOKEN=123456:ABC-your-bot-token

# ---------------------------------------------------------------------------
# Platform / Hardware Optimization (Apple Silicon / Mac)
# ---------------------------------------------------------------------------
# When true, unlocks multi-worker parallel processing (3 transcription workers
# + 4 concurrent downloads) utilizing Apple Silicon Metal GPU & unified memory.
# Set to false on low-RAM Linux VPS.
ON_MAC=false

# Comma-separated whitelist of Telegram user IDs allowed to use the bot.
# Empty = open to everyone who can message the bot.
ALLOWED_USER_IDS=

# Session name (the .session file lives under DATA_DIR).
SESSION_NAME=igtranscriber

# ---------------------------------------------------------------------------
# Paths & Storage Retention
# ---------------------------------------------------------------------------
# Working data dir: SQLite DB, temp files, logs, session file.
DATA_DIR=data

# Downloaded videos directory for temporary playback and ring buffer
DOWNLOADS_DIR=data/downloads

# FIFO ring buffer: maximum number of downloaded video files retained on disk
# before the oldest ones are automatically evicted
MAX_DOWNLOADED_VIDEOS=50

# Netscape-format cookies.txt exported for instagram.com (see README → Cookies).
# Strongly recommended: many reels fail without login cookies.
COOKIES_FILE=data/cookies.txt

# Optional: also save every generated .md here (e.g. your Obsidian vault).
# Empty = only send via Telegram.
MD_OUTPUT_DIR=

# Transcription mode:
# false = On-Demand mode (sends 9:16 video instantly with [✅ Transcribe & Add to Notes] button)
# true  = Auto-transcribe mode (automatically transcribes all incoming videos)
AUTO_TRANSCRIBE=false

# ---------------------------------------------------------------------------
# whisper.cpp
# ---------------------------------------------------------------------------
# Path to the whisper-cli binary (built by scripts/install_whisper_cpp.sh).
# Typical value when built locally: third_party/whisper.cpp/build/bin/whisper-cli
WHISPER_BIN=whisper-cli

# Model settings: large-v3-turbo-q5_0 (recommended for Apple Silicon / 2GB+ RAM)
WHISPER_MODEL_PATH=models/ggml-large-v3-turbo-q5_0.bin
WHISPER_MODEL_NAME=large-v3-turbo-q5_0
WHISPER_VAD_MODEL=models/ggml-silero-v6.2.0.bin

# Silero VAD: cuts silence and reduces hallucinated text on music/pauses.
WHISPER_VAD=true

# 0 = auto (all CPU threads minus one; Apple Silicon uses 9 threads).
WHISPER_THREADS=0

# Context carry-over between 30s windows: 0 disables it (recommended — reduces
# repetition loops); -1 restores whisper.cpp's default (unlimited).
WHISPER_MAX_CONTEXT=0

# Extra raw args appended to the whisper-cli invocation (shlex-split), e.g.
# "--beam-size 4". Empty by default.
WHISPER_EXTRA_ARGS=

# Safety timeout: base seconds plus per-audio-second allowance.
WHISPER_TIMEOUT_BASE=600
WHISPER_TIMEOUT_PER_SECOND=15.0

# Disable mmap memory mapping (useful for low-memory VPS environments)
WHISPER_NO_MMAP=false

# ---------------------------------------------------------------------------
# Transcript rendering & Hinglish
# ---------------------------------------------------------------------------
# roman  = bias mixed Hindi-English speech toward Roman script via an initial
#          prompt (best effort — see README → Hinglish limits)
# native = let Whisper choose the script (Hindi → Devanagari)
SCRIPT_MODE=roman

ROMAN_PROMPT=Yeh ek Hinglish video hai. Hindi and English mixed, written in Roman script.

# Insert [mm:ss] markers into transcripts roughly every N seconds.
TIMESTAMPS=true
TIMESTAMP_INTERVAL_SECONDS=45

# Keep [MUSIC]-style tags instead of stripping them.
TRANSCRIPT_KEEP_TAGS=false

# Send an inline preview when the transcript is shorter than this many chars.
PREVIEW_MAX_CHARS=3500

# ---------------------------------------------------------------------------
# Limits & concurrency
# ---------------------------------------------------------------------------
MAX_DURATION_SECONDS=1200     # 20 minutes max video length
MAX_FILESIZE_MB=500          # 500 MB max download size
RATE_LIMIT_PER_HOUR=0        # 0 = unlimited / disabled
WORKER_CONCURRENCY=1         # transcription workers (CPU-bound; keep 1 on small boxes, 3 on Mac)
DOWNLOAD_CONCURRENCY=2       # parallel downloads (2 on VPS, 4 on Mac)
MAX_LINKS_PER_MESSAGE=25     # maximum links to parse per single message
QUEUE_MAX_SIZE=500           # maximum pending jobs in queue

# ---------------------------------------------------------------------------
# Tooling / ops
# ---------------------------------------------------------------------------
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
HEALTH_CHECK_PORT=8080        # 0 disables; GET /health returns JSON stats
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# AI Summarization & 6-Stage Fallback (Optional)
# ---------------------------------------------------------------------------
# Primary Google Gemini API key (AIzaSy...) or any OpenAI-compatible API key
LLM_API_KEY=

# Backup / fallback Gemini key (used automatically if primary hits 429 quota exhaustion)
LLM_FALLBACK_API_KEY=

# Optional custom endpoint (e.g. https://generativelanguage.googleapis.com/v1beta/openai or https://api.openai.com/v1)
LLM_BASE_URL=

# Preferred starting model (e.g. gemini-3-flash, gemini-3.1-flash-lite, gemini-2.5-flash)
# Cascade sequence: gemini-3-flash (Acc 1 -> Acc 2) -> gemini-3.1-flash-lite (Acc 1 -> Acc 2) -> gemini-2.5-flash (Acc 1 -> Acc 2)
LLM_MODEL=gemini-3-flash

# Timeout for LLM summarization API requests in seconds
LLM_TIMEOUT_SECONDS=60.0
